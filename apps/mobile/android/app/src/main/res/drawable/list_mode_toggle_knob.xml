<?xml version="1.0" encoding="utf-8"?>
<!-- 表示切替トグルのノブ（トラックの中を左右に動く円）

     アプリのホームの切替トグル（ListModeToggle.tsx）と同じく白で固定し、トラックと同じ色の縁を付ける。
     ライトではキーボードの背景も白のため、縁がないとノブが背景に溶けて見えない。
     keyboardOnAccent は values / values-night のどちらも #FFFFFF。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/keyboardOnAccent" />
    <stroke
        android:width="1dp"
        android:color="@color/keyboardToggleOutline" />
</shape>
