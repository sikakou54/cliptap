<?xml version="1.0" encoding="utf-8"?>
<!-- 表示切替トグルのトラック

     アプリのホームの切替トグル（ListModeToggle.tsx）と同じく、塗りを持たず
     ノブが動く範囲を示す枠線だけを引く。表示対象で色を変えないため、定型文・ショートカットで共用する。
     角丸の半径はトラックの高さ32dpの半分にして、完全なピル形にする。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/keyboardToggleOutline" />
    <corners android:radius="16dp" />
</shape>
