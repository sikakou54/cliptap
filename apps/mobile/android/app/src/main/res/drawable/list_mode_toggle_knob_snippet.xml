<?xml version="1.0" encoding="utf-8"?>
<!-- 表示切替トグルのノブ（定型文を表示中。トラックの左端にいる紺の円）

     アプリのホームの切替トグル（ListModeToggle.tsx）と同じく、定型文は紺、ショートカットは黄色で塗る
     （ショートカット側は list_mode_toggle_knob_shortcut.xml）。
     紺は黒い背景に溶けやすいため、トラックと同じ色の縁を付ける。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/keyboardToggleKnobSnippet" />
    <stroke
        android:width="1dp"
        android:color="@color/keyboardToggleOutline" />
</shape>
